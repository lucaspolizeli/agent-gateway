{
  "servers": {
    "context7": { "command": "npx", "args": ["-y", "@upstash/context7-mcp"] },
    "globex-ado": {
      "command": "npx",
      "args": ["-y", "@azure-devops/mcp", "globex-org"],
      "env": { "AZURE_DEVOPS_PAT": "${ADO_PAT}" }
    },
    "acme-linear": {
      "url": "https://mcp.example.com/mcp",
      "headers": { "Authorization": "Bearer ${LINEAR_TOKEN}" }
    }
  },
  "profiles": {
    "global": { "servers": ["context7"], "skills": ["global"] },
    "globex": { "extends": ["global"], "servers": ["globex-ado"], "skills": ["globex"] },
    "globex-med": { "extends": ["globex"], "skills": ["globex-med"] },
    "acme": { "extends": ["global"], "servers": ["acme-linear"], "skills": ["acme"] }
  }
}
